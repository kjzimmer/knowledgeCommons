# The commons web app. Copy to .env for local development; never commit .env.

# Postgres for operational data only (sessions, usage log, gap notes). Optional locally: without it, Holon works
# but nothing is logged.
DATABASE_URL=

# Holon's model provider. A key created inside a workspace needs nothing else; a key not scoped to a workspace
# also needs ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Signed reviewer links (32+ characters). Changing it revokes every link.
REVIEW_LINK_SECRET=
# Comma-separated emails whose links no longer work
REVIEW_REVOKED=

# Public address, used in review links and in links returned by the public interface
PUBLIC_BASE_URL=http://localhost:3100

# Site keys for the public interface: "Site Name=secret;Other Site=secret2" (secrets 24+ characters)
SITE_KEYS=

# Optional overrides
# HOLON_MODEL=claude-sonnet-5-5
# DAILY_SPEND_CEILING_USD=2
# COMMONS_REPO=kjzimmer/knowledgeCommons
# COMMONS_BRANCH=main
NODE_ENV=development
PORT=3100
