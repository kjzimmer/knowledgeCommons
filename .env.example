# The commons web app. Copy to .env for local development; never commit .env.

# Postgres for operational and dialog data (sessions, usage log, gap notes, scheduled jobs, the monitor's history).
# Optional locally: without it, Holon works but nothing is logged and no jobs run.
DATABASE_URL=

# Holon's model provider. A key created inside a workspace needs nothing else; a key not scoped to a workspace
# also needs ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Signed reviewer links (32+ characters). Changing it revokes every link.
REVIEW_LINK_SECRET=
# Comma-separated emails whose links no longer work
REVIEW_REVOKED=

# Public address, used in review links and in links returned by the public interface
PUBLIC_BASE_URL=http://localhost:3100

# Site keys for the public interface: "Site Name=secret;Other Site=secret2" (secrets 24+ characters)
SITE_KEYS=

# The monitor (agents/monitor/). The key's expiry, as YYYY-MM-DD, recorded when the key is created: the monitor
# alerts 14 days before. Email alerts through Resend; MONITOR_ALERT_TO is the steward's address.
ANTHROPIC_KEY_EXPIRES=
RESEND_API_KEY=
MONITOR_ALERT_TO=
# MONITOR_ALERT_FROM="Commons monitor <onboarding@resend.dev>"
# Scheduled jobs need the database; SCHEDULER=off turns them off
# SCHEDULER=off

# Optional overrides
# HOLON_MODEL=claude-sonnet-5-5
# DAILY_SPEND_CEILING_USD=2
# COMMONS_REPO=kjzimmer/knowledgeCommons
# COMMONS_BRANCH=main
NODE_ENV=development
PORT=3100
